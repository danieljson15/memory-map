NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only — never prefix with NEXT_PUBLIC_, both would ship to the browser.
# Voyage AI embeddings (pin embedding on create, and scripts/backfill-embeddings.ts).
VOYAGE_API_KEY=your-voyage-api-key
# Supabase service role key — bypasses RLS. Only used by scripts/backfill-embeddings.ts,
# which runs outside a signed-in browser session. Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-side only. Enable Places API (New) and restrict this key to the
# deployed server's API usage. Used by autocomplete/details/nearby routes.
GOOGLE_PLACES_API_KEY=your-server-side-google-places-key

# Browser-visible by design. Enable Maps JavaScript API and restrict this key
# by HTTP referrer to localhost and your deployed domain.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-browser-google-maps-key
# Create a Google Cloud map ID for Advanced Markers; DEMO_MAP_ID is used if
# omitted, but a project-owned ID is recommended for deployment.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-google-map-id

# Server-side only, both optional. Self-imposed monthly caps checked against
# public.google_api_usage (see supabase/schema.sql and lib/usage.ts) before
# ever calling Google — a Cloud Console quota or budget alert alone can't
# promise a $0 bill, this is the actual control. Once either is hit, this
# app degrades itself (Leaflet map, or a "search unavailable" response)
# instead of continuing to call Google. Defaults below are conservative
# guesses for a two-person app with occasional public traffic, not a
# measured number — tune freely, no code change needed.
# GOOGLE_MAPS_MONTHLY_LOAD_ALLOWANCE=1500
# GOOGLE_PLACES_MONTHLY_REQUEST_ALLOWANCE=300

# Server-side only. Groq powers the whole-trip suggester.
GROQ_API_KEY=your-groq-api-key
